{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-validator.dev/contracts/model-metrics/v1/model-attempt.schema.json",
  "title": "Agent Validator model attempt measurement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "attempt_id", "revision", "measurement_schema_version", "session_id", "invocation_id", "lifecycle", "adapter", "outcome", "requested_identity", "resolved_identity", "observed_identities", "observed_identity_availability", "tokens", "provider_native_usage", "completeness", "allocations", "unallocated_usage", "provider_reported_costs", "provenance", "diagnostics"],
  "properties": {
    "record_type": { "const": "model_attempt" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "measurement_schema_version": { "const": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "invocation_id": { "type": "string", "minLength": 1 },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "adapter": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["passed", "failed", "error", "interrupted", "unknown"] },
    "requested_identity": { "$ref": "#/$defs/identity" },
    "resolved_identity": { "$ref": "#/$defs/identity" },
    "observed_identities": { "type": "array", "items": { "$ref": "#/$defs/observedIdentity" } },
    "observed_identity_availability": { "$ref": "#/$defs/availability" },
    "tokens": { "$ref": "#/$defs/tokens" },
    "provider_native_usage": { "type": "array", "items": { "$ref": "#/$defs/nativeUsage" } },
    "completeness": { "$ref": "#/$defs/completeness" },
    "allocations": { "type": "array", "items": { "$ref": "#/$defs/allocation" } },
    "unallocated_usage": { "anyOf": [{ "$ref": "#/$defs/unallocated" }, { "type": "null" }] },
    "provider_reported_costs": { "type": "array", "items": { "$ref": "#/$defs/cost" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "diagnostics": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "review_context": { "type": "object", "additionalProperties": false, "required": ["gate", "slot"], "properties": { "gate": { "type": "string", "minLength": 1 }, "slot": { "type": "integer", "minimum": 0 } } }
  },
  "$defs": {
    "availability": { "type": "object", "additionalProperties": false, "required": ["availability", "reason"], "properties": { "availability": { "enum": ["available", "unavailable"] }, "reason": { "type": ["string", "null"] } } },
    "lifecycle": { "type": "object", "additionalProperties": false, "required": ["state", "started_at", "ended_at"], "properties": { "state": { "enum": ["prepared", "running", "completed", "failed", "interrupted"] }, "started_at": { "type": ["string", "null"], "format": "date-time" }, "ended_at": { "type": ["string", "null"], "format": "date-time" } } },
    "identity": { "type": "object", "additionalProperties": false, "required": ["adapter", "model", "provider", "effort", "provenance"], "properties": { "adapter": { "type": ["string", "null"] }, "model": { "type": ["string", "null"] }, "provider": { "type": ["string", "null"] }, "effort": { "type": ["string", "null"] }, "provenance": { "enum": ["configuration", "launch_resolution", "telemetry"] } } },
    "observedIdentity": { "type": "object", "additionalProperties": false, "required": ["identity_id", "model", "provider", "effort", "provenance"], "properties": { "identity_id": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "provider": { "$ref": "#/$defs/availability" }, "effort": { "$ref": "#/$defs/availability" }, "provenance": { "const": "telemetry" } } },
    "measurement": { "type": "object", "additionalProperties": false, "required": ["availability", "value", "reason", "source", "origin", "precision", "derivation", "included_in"], "properties": { "availability": { "enum": ["available", "unavailable"] }, "value": { "type": ["integer", "null"], "minimum": 0 }, "reason": { "type": ["string", "null"] }, "source": { "enum": ["provider_usage", "provider_display", "provider_event", "validator_derivation", null] }, "origin": { "enum": ["observed", "derived", null] }, "precision": { "enum": ["exact", "approximate", null] }, "derivation": { "type": ["string", "null"] }, "included_in": { "type": ["array", "null"], "items": { "type": "string" } } } },
    "tokens": { "type": "object", "additionalProperties": false, "required": ["input_total", "input_uncached", "cache_read", "cache_write", "output", "reasoning", "provider_total", "normalized_total"], "properties": { "input_total": { "$ref": "#/$defs/measurement" }, "input_uncached": { "$ref": "#/$defs/measurement" }, "cache_read": { "$ref": "#/$defs/measurement" }, "cache_write": { "$ref": "#/$defs/measurement" }, "output": { "$ref": "#/$defs/measurement" }, "reasoning": { "$ref": "#/$defs/measurement" }, "provider_total": { "$ref": "#/$defs/measurement" }, "normalized_total": { "$ref": "#/$defs/measurement" } } },
    "nativeUsage": { "type": "object", "additionalProperties": false, "required": ["source", "name", "value"], "properties": { "source": { "enum": ["provider_usage", "provider_display", "provider_event", "validator_derivation"] }, "name": { "type": "string" }, "value": { "type": ["string", "number"] } } },
    "completeness": { "type": "object", "additionalProperties": false, "required": ["history", "collection", "canonical_fields", "normalized_total", "per_model_attribution"], "properties": { "history": { "enum": ["complete", "partial", "unavailable"] }, "collection": { "enum": ["complete", "partial", "unavailable"] }, "canonical_fields": { "enum": ["complete", "partial", "unavailable"] }, "normalized_total": { "enum": ["complete", "partial", "unavailable"] }, "per_model_attribution": { "enum": ["complete", "partial", "unavailable"] } } },
    "allocation": { "type": "object", "additionalProperties": false, "required": ["allocation_id", "observed_identity_ref", "usage"], "properties": { "allocation_id": { "type": "string" }, "observed_identity_ref": { "type": "string" }, "usage": { "type": "object" } } },
    "unallocated": { "type": "object", "additionalProperties": false, "required": ["allocation_id", "observed_identity_ref", "usage"], "properties": { "allocation_id": { "type": "string" }, "observed_identity_ref": { "type": "object" }, "usage": { "type": "object" } } },
    "cost": { "type": "object", "additionalProperties": false, "required": ["cost_evidence_id", "amount", "currency", "scope", "coverage", "overlap", "source"], "properties": { "cost_evidence_id": { "type": "string" }, "amount": { "type": "object" }, "currency": { "$ref": "#/$defs/availability" }, "scope": { "enum": ["attempt", "allocation", "unavailable"] }, "allocation_id": { "type": "string" }, "coverage": { "enum": ["full", "partial", "unknown"] }, "overlap": { "enum": ["established", "unknown"] }, "source": { "enum": ["provider_usage", "provider_display", "provider_event", "validator_derivation"] } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["producer_version", "build", "adapter_mapping_version", "cli_version", "source_format_version"], "properties": { "producer_version": { "type": "string" }, "build": { "$ref": "#/$defs/availability" }, "adapter_mapping_version": { "type": "string" }, "cli_version": { "$ref": "#/$defs/availability" }, "source_format_version": { "$ref": "#/$defs/availability" } } }
  }
}
